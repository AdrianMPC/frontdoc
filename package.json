{
  "name": "frontdocs",
  "version": "0.1.0",
  "description": "Zero-config component explorer for React: props from your TypeScript types, live controls, preview and JSX snippets.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "frontdocs": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ui",
    "!ui/test-*.ts",
    "!ui/fixtures.json",
    "!ui/tsconfig.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdrianMPC/frontdoc.git"
  },
  "keywords": [
    "react",
    "components",
    "component-explorer",
    "documentation",
    "props",
    "typescript",
    "react-docgen-typescript",
    "storybook-alternative",
    "vite"
  ],
  "author": "AdrianMPC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AdrianMPC/frontdoc/issues"
  },
  "homepage": "https://github.com/AdrianMPC/frontdoc#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "^5.0.0",
    "react-docgen-typescript": "^2.4.0",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "typescript": ">=5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
